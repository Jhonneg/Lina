# Server-side only. Leave these blank for development mock mode.
OPENAI_API_KEY=
OPENAI_MODEL=

# mock is accepted only when NODE_ENV=development.
# Set openai and configure both variables above to enable real, billable calls.
LAIN_AI_MODE=mock

# Local Docker Compose: copy this file to untracked .env and set a password.
# Compose uses postgres:17, user lain, database lain_dev, 127.0.0.1:5432.
# This password initializes an empty volume; changing it does not reset existing data.
POSTGRES_PASSWORD=

# Server-side PostgreSQL only. Optional until database features are used.
# Local URL: postgresql://lain:URL_ENCODED_PASSWORD@127.0.0.1:5432/lain_dev
# Use the same password as above, URL-encoding special characters.
# Next.js/Drizzle also read .env; .env.local or exported variables may override it.
DATABASE_URL=
