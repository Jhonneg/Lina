# Server-side only. Leave these blank for development mock mode.
OPENAI_API_KEY=
OPENAI_MODEL=

# mock is accepted only when NODE_ENV=development.
# Set openai and configure both variables above to enable real, billable calls.
LAIN_AI_MODE=mock

# Local Docker Compose: copy this file to untracked .env and set a password.
# Compose uses postgres:17, user lain, database lain_dev, 127.0.0.1:5432.
# This password initializes an empty volume; changing it does not reset existing data.
POSTGRES_PASSWORD=

# Server-side PostgreSQL only. Optional until database features are used.
# Local URL: postgresql://lain:URL_ENCODED_PASSWORD@127.0.0.1:5432/lain_dev
# Use the same password as above, URL-encoding special characters.
# Next.js/Drizzle also read .env; .env.local or exported variables may override it.
DATABASE_URL=
# Neon: runtime uses the pooled -pooler hostname with sslmode=verify-full.
# Provision bounded role timeouts through the direct URL first (see deployment doc).
# Migrations use the DIRECT URL; keep it out of Netlify Functions scope.
# Optional locally; falls back to DATABASE_URL. Never run migrations at startup.
DATABASE_MIGRATION_URL=

# Persistent paid-API protection. Apply reviewed Drizzle migrations before paid use.
# Defaults below count provider attempts, including every progressive speech segment.
USAGE_TEXT_HOURLY_LIMIT=20
USAGE_TEXT_DAILY_LIMIT=100
USAGE_SPEECH_HOURLY_LIMIT=20
USAGE_SPEECH_DAILY_LIMIT=60
USAGE_SPEECH_MINUTE_LIMIT=3
USAGE_SESSION_CONCURRENCY=2
USAGE_GLOBAL_CONCURRENCY=4
USAGE_DAILY_BUDGET_USD=1
USAGE_IP_MINUTE_LIMIT=20
USAGE_IP_HOURLY_LIMIT=100

# Required for paid text: current USD per million tokens for OPENAI_MODEL.
# Leave blank in mock mode. Cached rate defaults to input rate; must not exceed it.
USAGE_TEXT_INPUT_USD_PER_MILLION=
USAGE_TEXT_CACHED_USD_PER_MILLION=
USAGE_TEXT_OUTPUT_USD_PER_MILLION=

# Local development ignores all forwarded IP headers. Production fails closed
# with "none". Netlify: set "netlify" plus a random server-only HMAC secret
# of at least 32 characters. Uses @netlify/functions getContext().ip exclusively;
# missing platform request context fails closed. No runtime NETLIFY flag needed.
# Never trust arbitrary x-forwarded-for or expose this key to the browser.
USAGE_TRUSTED_PROXY=none
USAGE_IP_HMAC_KEY=
# Cloud voice uses OPENAI_API_KEY; no local model/download configuration is needed.
# Cloud voice remains development-only regardless of these settings.

# Non-billable APIs: fixed UTC minute/day windows, per IP and verified session.
# Reuses USAGE_TRUSTED_PROXY and USAGE_IP_HMAC_KEY; production fails closed
# without genuine supported ingress. Local development shares an IP bucket.
API_SESSION_IP_MINUTE=20
API_SESSION_IP_DAY=200
API_SESSION_SESSION_MINUTE=20
API_SESSION_SESSION_DAY=200
API_CREATE_IP_MINUTE=10
API_CREATE_IP_DAY=100
API_CREATE_SESSION_MINUTE=5
API_CREATE_SESSION_DAY=50
API_READ_IP_MINUTE=120
API_READ_IP_DAY=2000
API_READ_SESSION_MINUTE=60
API_READ_SESSION_DAY=1000
API_MUTATE_IP_MINUTE=30
API_MUTATE_IP_DAY=300
API_MUTATE_SESSION_MINUTE=15
API_MUTATE_SESSION_DAY=150
STORAGE_CONVERSATIONS_PER_SESSION=50
STORAGE_MESSAGES_PER_SESSION=1000

# Explicit maintenance only; never performed automatically on requests/startup.
# Cleanup defaults to dry-run. --apply permanently removes expired-session data
# only after this grace period; review the target before opting in.
SESSION_EXPIRED_RETENTION_DAYS=7
API_CLEANUP_BATCH=100

# Netlify scheduled cleanup runs every 15 minutes, dry-run by default.
# Set true only after reviewing the production database and retention policy.
SESSION_CLEANUP_APPLY=false
